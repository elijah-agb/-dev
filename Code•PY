@app.get("/")
def home():
    return render_template_string(
        PAGE, p=PROFILE, projects=PROJECTS, skills=SKILLS,
        sent=request.args.get("sent") == "1", year=datetime.now().year,
    )


@app.post("/contact")
def contact():
    entry = {
        "time": datetime.now().isoformat(timespec="seconds"),
        "name": request.form.get("name", "").strip()[:80],
        "email": request.form.get("email", "").strip()[:120],
        "message": request.form.get("message", "").strip()[:2000],
    }
    if entry["name"] and entry["email"] and entry["message"]:
        data = json.loads(MESSAGES.read_text()) if MESSAGES.exists() else []
        data.append(entry)
        MESSAGES.write_text(json.dumps(data, indent=2))
    return redirect(url_for("home", sent=1) + "#contact")


